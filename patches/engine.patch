+static bool vitaFetchPublicAvatarThumbnail(VitaAvatarThumbnail request, std::string& response)
+{
+    static std::map<std::string, std::string> users;
+    try
+    {
+        if (request.userId.empty())
+        {
+            {
+                boost::mutex::scoped_lock lock(vitaAssetCacheMutex);
+                const auto found = users.find(request.username);
+                if (found != users.end()) request.userId = found->second;
+            }
+            if (request.userId.empty())
+            {
+                Http lookup("https://users.roblox.com/v1/usernames/users");
+                lookup.shouldRetry = false;
+                lookup.setConnectionTimeout(5000);
+                lookup.setResponseTimeout(15000);
+                std::istringstream body("{\"usernames\":[\"" + request.username + "\"],\"excludeBannedUsers\":true}");
+                std::string json;
+                lookup.post(body, "application/json", false, json, true);
+                rapidjson::Document document;
+                document.Parse<0>(json.c_str());
+                if (document.HasParseError() || !document.IsObject() || !document.HasMember("data") ||
+                    !document["data"].IsArray() || document["data"].Size()!=1) return false;
+                const auto& user = document["data"][rapidjson::SizeType(0)];
+                if (!user.IsObject() || !user.HasMember("id") || !user["id"].IsUint64() || !user["id"].GetUint64() ||
+                    !user.HasMember("requestedUsername") || !user["requestedUsername"].IsString()) return false;
+                std::string matched = user["requestedUsername"].GetString();
+                std::transform(matched.begin(), matched.end(), matched.begin(), [](unsigned char c){return std::tolower(c);});
+                if (matched != request.username) return false;
+                request.userId = std::to_string(user["id"].GetUint64());
+                boost::mutex::scoped_lock lock(vitaAssetCacheMutex);
+                if (users.size()<256) users[request.username]=request.userId;
+            }
+        }
+        const std::string kind = request.headshot ? "avatar-headshot" : "avatar";
+        return vitaFetchPublicThumbnail(kind+"-"+request.userId, request.size,
+            "https://thumbnails.roblox.com/v1/users/"+kind+"?userIds="+request.userId+
+            "&size="+request.size+"&format=Png&isCircular=false", response);
+    }
+    catch (const std::exception&) { return false; }
+}
