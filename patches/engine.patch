+bool FastCluster::deferDistantGeometry(const Extents& bounds)
+{
+    // Keep awake objects and characters resident. Sleeping world parts retain
+    // their bindings and physics while only distant render buffers are released.
+    if (!fw || humanoid || bounds.isNull()) return false;
+    const Vector3& focus = getVisualEngine()->getSceneManager()->getPointOfInterest();
+    const float distanceSq = getVisualEngine()->getFrameRateManager()->GetViewCullSqDistance();
+    if (bounds.computeClosestSqDistanceToPoint(focus) <= distanceSq * 1.5625f) return false;
+    for (size_t i = 0; i < entities.size(); ++i) delete entities[i];
+    entities.clear();
+    sharedGeometry.reset();
+    getVisualEngine()->getSceneUpdater()->notifyWaitingForAssets(this, std::vector<ContentId>());
+    updateWorldBounds(bounds);
+    setBlockCount(parts.size());
+    vitaGeometryDeferred = true;
+    dirty = false;
+    return true;
+}
+
+void FastCluster::updateGeometryResidency()
+{
+    if (dirty) return;
+    if (vitaGeometryDeferred) {
+        // Build approaching world geometry before it enters the visible range.
+        // Waiting until updateRenderQueue sees it causes empty buildings/pop-in
+        // while a bounded cluster rebuild is still queued. Use the normal queue
+        // and a smaller radius than retirement to keep the existing hysteresis.
+        const Vector3& focus=getVisualEngine()->getSceneManager()->getPointOfInterest();
+        const float distanceSq=getVisualEngine()->getFrameRateManager()->GetViewCullSqDistance();
+        if (getWorldBounds().computeClosestSqDistanceToPoint(focus)<=distanceSq*1.265625f)
+            invalidateEntity();
+    } else deferDistantGeometry(getWorldBounds());
+}
+
+void FastCluster::updateRenderQueue(RenderQueue& queue, const RenderCamera& camera, RenderQueue::Pass pass)
+{
+    if (vitaGeometryDeferred) {
+        // FRM exempts unhashed (large) bounds from distance culling. That
+        // exemption must not repeatedly restore a deferred cluster whose
+        // entire bounds are still outside the residency radius.
+        if (!dirty && !updateIsCulledByFRM() &&
+            getWorldBounds().computeClosestSqDistanceToPoint(
+                getVisualEngine()->getSceneManager()->getPointOfInterest()) <=
+                getVisualEngine()->getFrameRateManager()->GetRenderCullSqDistance())
+            priorityInvalidateEntity();
+        return;
+    }
+    RenderNode::updateRenderQueue(queue, camera, pass);
+}
