+// Internal adapter used by AST lowering. It bypasses user-visible metatable
+// protection just as the VM's generalized iterator setup does.
+static int rbxLuauNext(lua_State* state)
+{
+    lua_settop(state, 2);
+    return lua_next(state, 1) ? 2 : 0;
+}
+
+static int rbxLuauIter(lua_State* state)
+{
+    const int count = lua_gettop(state);
+    if (lua_isfunction(state, 1)) return count;
+    if (lua_getmetatable(state, 1))
+    {
+        lua_pushliteral(state, "__iter");
+        lua_rawget(state, -2);
+        if (!lua_isnil(state, -1))
+        {
+            lua_pushvalue(state, 1);
+            lua_call(state, 1, 3);
+            return 3;
+        }
+        lua_pop(state, 1);
+        lua_pushliteral(state, "__call");
+        lua_rawget(state, -2);
+        const bool callable = !lua_isnil(state, -1);
+        lua_settop(state, count);
+        if (callable) return count;
+    }
+    if (!lua_istable(state, 1)) return luaL_error(state, "Cannot iterate over this value");
+    lua_pushcfunction(state, rbxLuauNext);
+    lua_pushvalue(state, 1);
+    lua_pushnil(state);
+    return 3;
+}
+
+static int rbxLuauTypeof(lua_State* state)
+{
+    luaL_checkany(state, 1);
+    if (lua_type(state, 1) == LUA_TUSERDATA && lua_getmetatable(state, 1))
+    {
+        lua_pushliteral(state, "__type");
+        lua_rawget(state, -2);
+        if (lua_type(state, -1) == LUA_TSTRING)
+        {
+            if (strcmp(lua_tostring(state, -1), "Object") == 0)
+                lua_pushliteral(state, "Instance");
+            return 1;
+        }
+    }
+    lua_pushstring(state, lua_typename(state, lua_type(state, 1)));
+    return 1;
+}
