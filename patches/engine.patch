+LUA_API void *lua_typeduserdatafast (lua_State *L, int idx, const char *tname) {
+  RBX_VITA_LUA_SCOPE;
+  StkId o = index2adr(L, idx);
+  if (!ttisuserdata(o) || uvalue(o)->metatable == NULL || !ttistable(registry(L)))
+    return NULL;
+  lua_lock(L);
+  /* A raw matching registry entry is exactly the result of the normal
+     getfield/rawequal check. Missing or unusual entries use the old path,
+     which also preserves registry __index and lightuserdata behavior. */
+  Table *mt = uvalue(o)->metatable;
+  const TValue *registered = luaH_getstr(hvalue(registry(L)), luaS_new(L, tname));
+  void *result = ttistable(registered) && hvalue(registered) == mt
+    ? (rawuvalue(o) + 1) : NULL;
+  lua_unlock(L);
+  return result;
+}
+#endif
