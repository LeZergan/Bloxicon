+int ScriptContext::scheduleTask(lua_State* thread, int functionIndex, double timeout, bool immediate)
+{
+	ThreadRef caller(thread);
+	const int arguments = lua_gettop(thread) - functionIndex;
+	// Arguments are duplicated below before being moved. The Lua C API does
+	// not grow either stack during pushvalue/xmove, including in release builds.
+	if (arguments < 0 || !lua_checkstack(thread, arguments + 2))
+		throw RBX::runtime_error("task arguments exceed Lua stack capacity");
+	lua_State* target = NULL;
+	if (lua_isthread(thread, functionIndex))
+	{
+		target = lua_tothread(thread, functionIndex);
+		if (target == thread || RobloxExtraSpace::get(target)->yieldCaptured)
+			throw RBX::runtime_error("task cannot resume a running or already scheduled thread");
+		if (!lua_checkstack(target, arguments))
+			throw RBX::runtime_error("task coroutine stack capacity exceeded");
+		lua_pushvalue(thread, functionIndex);
+	}
+	else
+	{
+		luaL_checktype(thread, functionIndex, LUA_TFUNCTION);
+		target = lua_newthread(thread);
+		if (!lua_checkstack(target, arguments + 1))
+		{
+			lua_pop(thread, 1);
+			throw RBX::runtime_error("task coroutine stack capacity exceeded");
+		}
+		lua_pushvalue(thread, functionIndex);
+		lua_xmove(thread, target, 1);
+	}
+	ThreadRef retained(target);
+	for (int i = 0; i < arguments; ++i)
+		lua_pushvalue(thread, functionIndex + 1 + i);
+	lua_xmove(thread, target, arguments);
+	ScriptContext& context = getContext(thread);
+	if (immediate)
+	{
+		if (context.resume(retained, arguments) != Yield)
+			lua_resetstack(target, 0);
+	}
+	else if (context.yieldEvent)
+		context.yieldEvent->queueTask(target, timeout, arguments);
+	return 1;
