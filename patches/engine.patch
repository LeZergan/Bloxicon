+#if defined(RBX_PLATFORM_PSVITA)
+static void vitaPersistAsset(const std::string& assetId, std::string& data) noexcept
+{
+    // Persistence is optional. Allocation, locking or storage failure must not
+    // discard a successful download or enter the transport retry path.
+    try
+    {
+    if (assetId.empty() || data.empty())
+        return;
+
+    // The Vita HTTP stack requests identity transfer encoding, but some
+    // historical asset responses are still gzip-wrapped. Return decoded
+    // payloads to the first requester as well as caching them. The
+    // ContentProvider also handles already-installed compressed files.
+    if (VitaAssetPayload::isGzip(data))
+    {
+        std::string decoded;
+        if (!VitaAssetPayload::decodeGzip(data, &decoded))
+        {
+            std::fprintf(stderr, "Vita asset invalid HTTP gzip %s\n", assetId.c_str());
+            return;
+        }
+        data.swap(decoded);
+    }
+
+    const auto gate = vitaAssetFileLocks.get("asset-" + assetId);
+    boost::mutex::scoped_lock lock(*gate);
+    sceIoMkdir("ux0:/data/RBXV00001", 0777);
+    sceIoMkdir("ux0:/data/RBXV00001/assets", 0777);
+
+    const std::string finalPath = "ux0:/data/RBXV00001/assets/" + assetId;
+    if (FILE* existing = std::fopen(finalPath.c_str(), "rb"))
+    {
+        std::fclose(existing);
+        return;
+    }
+
+    const std::string tempPath = finalPath + ".download";
+    FILE* file = std::fopen(tempPath.c_str(), "wb");
+    if (!file)
+        return;
+
+    const size_t written = std::fwrite(data.data(), 1, data.size(), file);
+    const bool closed = std::fclose(file) == 0;
+    if (written != data.size() || !closed || sceIoRename(tempPath.c_str(), finalPath.c_str()) < 0)
+    {
+        sceIoRemove(tempPath.c_str());
+        return;
+    }
+
+    std::fprintf(stderr, "Vita asset cache stored %s (%u bytes)\n",
+        assetId.c_str(), unsigned(data.size()));
+    }
+    catch (...) {} // Keep the response when an optional cache cannot be saved.
+}
