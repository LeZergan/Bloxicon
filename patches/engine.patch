+static bool vitaTrustedPublicAssetLocation(const std::string& url)
+{
+    static const std::string https = "https://";
+    if (url.compare(0, https.size(), https) != 0)
+        return false;
+
+    const size_t authorityBegin = https.size();
+    const size_t authorityEnd = url.find_first_of("/?#", authorityBegin);
+    std::string host = url.substr(authorityBegin,
+        authorityEnd == std::string::npos ? std::string::npos : authorityEnd - authorityBegin);
+    if (host.empty() || host.find('@') != std::string::npos || host.find(':') != std::string::npos)
+        return false;
+
+    std::transform(host.begin(), host.end(), host.begin(), ::tolower);
+    const std::string cdn = "rbxcdn.com";
+    const std::string roblox = "roblox.com";
+    const bool cdnHost = host == cdn ||
+        (host.size() > cdn.size() && host.compare(host.size() - cdn.size(), cdn.size(), cdn) == 0 &&
+            host[host.size() - cdn.size() - 1] == '.');
+    const bool robloxHost = host == roblox ||
+        (host.size() > roblox.size() && host.compare(host.size() - roblox.size(), roblox.size(), roblox) == 0 &&
+            host[host.size() - roblox.size() - 1] == '.');
+    return cdnHost || robloxHost;
+}
