+void LightGrid::lightingStageChunk(LightGridChunk& chunk)
+{
+    if (!texture)
+        return;
+
+    if (texture->getType() != Texture::Type_2D)
+    {
+        lightingUploadChunk(chunk);
+        return;
+    }
+
+    const int textureWidth = texture->getWidth();
+    const int textureHeight = texture->getHeight();
+    const size_t atlasSize = static_cast<size_t>(textureWidth) * textureHeight * 4;
+
+    // Relocation and bulk loading normally initialize this mirror. Recover
+    // with one complete upload if a device restore reached us first.
+    if (uploadAtlasScratch.size() != atlasSize)
+    {
+        lightingUploadAll();
+        return;
+    }
+
+    const int atlasPitch = textureWidth * 4;
+    const int gridDepth = chunkCount.y * kLightGridChunkSizeY;
+    const int gridDepthSqrt = isqrt(gridDepth);
+    const int gridWidth = chunkCount.x * kLightGridChunkSizeXZ;
+    const int gridHeight = chunkCount.z * kLightGridChunkSizeXZ;
+    const Vector3int32 wrappedIndex = getWrappedChunkIndex(chunk.index);
+    const Vector3int32 gridPos = wrappedIndex * kLightGridChunkSize;
+
+    lightingComposit(chunk, uploadScratch[0][0][0], kLightGridChunkSizeXZ * 4,
+        kLightGridChunkSizeXZ * kLightGridChunkSizeXZ * 4);
+    fillLightingBorders(uploadScratch, chunk.index, cornerChunkIndex, chunkCount,
+        transformColor(skyAmbient));
+
+    const size_t bandCount = textureHeight / kLightGridChunkSizeXZ;
+    for (size_t i = 0; i < uploadTextureDirtyRows.size(); ++i)
+        uploadTextureDirtyRows[i].resize(bandCount, 0);
+
+    for (int y = 0; y < kLightGridChunkSizeY; ++y)
+    {
+        const int slice = (gridPos.y + y) % gridDepth;
+        const int boxLeft = (gridPos.x + (slice % gridDepthSqrt) * gridWidth) % textureWidth;
+        const int boxTop = (gridPos.z + (slice / gridDepthSqrt) * gridHeight) % textureHeight;
+
+        // The live atlas reuses the previous snapshot's storage. Seed each band
+        // before its first edit so untouched pixels retain the frozen baseline.
+        const size_t band = boxTop / kLightGridChunkSizeXZ;
+        lightingSeedAtlasBand(band);
+
+        for (int z = 0; z < kLightGridChunkSizeXZ; ++z)
+            memcpy(&uploadAtlasScratch[(boxTop + z) * atlasPitch + boxLeft * 4],
+                uploadScratch[y][z], kLightGridChunkSizeXZ * 4);
