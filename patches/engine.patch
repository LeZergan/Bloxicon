+static void writeVitaImageCache(const std::string& assetId, const std::string& data)
+{
+    if (assetId.empty() || data.empty() || data.size() > 8 * 1024 * 1024)
+        return;
+    sceIoMkdir("ux0:/data/RBXV00001", 0777);
+    sceIoMkdir("ux0:/data/RBXV00001/system/image-cache", 0777);
+    const std::string finalPath = "ux0:/data/RBXV00001/system/image-cache/" + assetId;
+    std::lock_guard<std::mutex> lock(RBX::VitaCacheBudget::mutex());
+    if (!RBX::VitaCacheBudget::trim("ux0:/data/RBXV00001/system/image-cache", RBX::VitaCacheBudget::Images,
+        64u * 1024u * 1024u, finalPath, data.size())) return;
+    const std::string tempPath = finalPath + ".download";
+    FILE* file = std::fopen(tempPath.c_str(), "wb");
+    if (!file)
+        return;
+    const size_t written = std::fwrite(data.data(), 1, data.size(), file);
+    const int closed = std::fclose(file);
+    if (written != data.size() || closed != 0)
+    {
+        sceIoRemove(tempPath.c_str());
+        return;
+    }
+    if (!RBX::VitaAtomicFile::commit(finalPath, tempPath))
+        sceIoRemove(tempPath.c_str());
+}
