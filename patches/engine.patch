+void LightGrid::lightingStageAll()
+{
+    if (!texture || texture->getType() != Texture::Type_2D)
+        return;
+
+    const int textureWidth = texture->getWidth();
+    const int textureHeight = texture->getHeight();
+    const int atlasPitch = textureWidth * 4;
+    const int gridDepth = chunkCount.y * kLightGridChunkSizeY;
+    const int gridDepthSqrt = isqrt(gridDepth);
+    const int gridWidth = chunkCount.x * kLightGridChunkSizeXZ;
+    const int gridHeight = chunkCount.z * kLightGridChunkSizeXZ;
+
+    uploadAtlasScratch.resize(textureWidth * textureHeight * 4);
+    // Reserve the equally sized spare during loading, never during publication.
+    uploadSnapshot.resize(uploadAtlasScratch.size());
+
+    for (size_t i = 0; i < chunks.size(); ++i)
+    {
+        LightGridChunk& chunk = *chunks[i];
+        Vector3int32 wrappedIndex = getWrappedChunkIndex(chunk.index);
+        Vector3int32 gridPos = wrappedIndex * kLightGridChunkSize;
+
+        lightingComposit(chunk, uploadScratch[0][0][0], kLightGridChunkSizeXZ * 4,
+            kLightGridChunkSizeXZ * kLightGridChunkSizeXZ * 4);
+        fillLightingBorders(uploadScratch, chunk.index, cornerChunkIndex, chunkCount, transformColor(skyAmbient));
+
+        for (int y = 0; y < kLightGridChunkSizeY; ++y)
+        {
+            const int slice = (gridPos.y + y) % gridDepth;
+            const int boxLeft = (gridPos.x + (slice % gridDepthSqrt) * gridWidth) % textureWidth;
+            const int boxTop = (gridPos.z + (slice / gridDepthSqrt) * gridHeight) % textureHeight;
+
+            for (int z = 0; z < kLightGridChunkSizeXZ; ++z)
+                memcpy(&uploadAtlasScratch[(boxTop + z) * atlasPitch + boxLeft * 4],
+                    uploadScratch[y][z], kLightGridChunkSizeXZ * 4);
+        }
+    }
+
+    // All buffered textures now need the new image. The active texture remains
+    // coherent with renderCornerChunkIndex until a complete inactive atlas is
+    // ready for an atomic swap.
+    for (size_t i = 0; i < uploadTextureDirtyRows.size(); ++i)
+        uploadTextureDirtyRows[i].assign(textureHeight / kLightGridChunkSizeXZ, 1);
+    // A relocation rewrites every live byte and supersedes baseline seeding,
+    // while the in-flight snapshot and its coordinate origin stay immutable.
+    uploadAtlasCopiedRows.assign(textureHeight / kLightGridChunkSizeXZ, 1);
+    uploadAtlasCopyRow = uploadAtlasCopiedRows.size();
+}
+#endif
