+    std::vector<uintptr_t> keys;
+    size_t cursor = 0;
+    bool unchanged = false;
+    void begin() {cursor = 0; unchanged = true;}
+    void add(uintptr_t value)
+    {
+        if (cursor == keys.size()) {keys.push_back(value); unchanged = false;}
+        else if (keys[cursor] != value) {keys[cursor] = value; unchanged = false;}
+        ++cursor;
+    }
+    template<class T> void pointer(T* value) {add(reinterpret_cast<uintptr_t>(value));}
