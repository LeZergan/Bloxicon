+static bool vitaFetchPublicAssetByMetadata(const std::string& assetId, std::string& response)
+{
+    if (assetId.empty())
+        return false;
+
+    try
+    {
+        std::string metadata;
+        // Keep the old /v1/asset/?id= redirect path for original-client raw
+        // payload compatibility, but use Roblox's current anonymous v2 metadata
+        // API when that legacy request is denied. v2 returns a locations array
+        // instead of v1's single top-level location field.
+        Http metadataRequest("https://assetdelivery.roblox.com/v2/assetId/" + assetId);
+        metadataRequest.shouldRetry = false;
+        metadataRequest.setConnectionTimeout(5000);
+        metadataRequest.setResponseTimeout(15000);
+        metadataRequest.get(metadata, true);
+
+        shared_ptr<const RBX::Reflection::ValueTable> table;
+        if (!RBX::WebParser::parseJSONTable(metadata, table) || !table)
+            return false;
+
+        RBX::Reflection::ValueTable::const_iterator locationsIt = table->find("locations");
+        if (locationsIt == table->end() ||
+            !locationsIt->second.isType<shared_ptr<const Reflection::ValueArray> >())
+            return false;
+
+        shared_ptr<const Reflection::ValueArray> locations =
+            locationsIt->second.cast<shared_ptr<const Reflection::ValueArray> >();
+        std::string publicLocation;
+        for (Reflection::ValueArray::const_iterator it = locations->begin(); it != locations->end(); ++it)
+        {
+            if (!it->isType<shared_ptr<const Reflection::ValueTable> >())
+                continue;
+
+            shared_ptr<const Reflection::ValueTable> entry =
+                it->cast<shared_ptr<const Reflection::ValueTable> >();
+            Reflection::ValueTable::const_iterator location = entry->find("location");
+            if (location == entry->end() || !location->second.isString())
+                continue;
+
+            Reflection::ValueTable::const_iterator format = entry->find("assetFormat");
+            if (format != entry->end() && format->second.isString() &&
+                format->second.get<std::string>() != "source")
+                continue;
+
+            publicLocation = location->second.get<std::string>();
+            break;
+        }
+        if (publicLocation.empty())
+            return false;
+        if (!vitaTrustedPublicAssetLocation(publicLocation))
+            return false;
+
+        // The returned CDN URL contains a short-lived signature. Treat it as a
+        // transport capability: request it anonymously and never print/store it.
+        Http payloadRequest(publicLocation);
+        payloadRequest.shouldRetry = false;
+        payloadRequest.setConnectionTimeout(5000);
+        payloadRequest.setResponseTimeout(15000);
+        std::string payload;
+        payloadRequest.get(payload, true);
+        if (payload.empty() || payload.size() > 32 * 1024 * 1024)
+            return false;
+
+        response.swap(payload);
+        return true;
+    }
+    catch (const std::exception&)
+    {
+        return false;
+    }
+}
