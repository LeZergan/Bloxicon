+static bool extractVitaJsonString(const std::string& json, const char* key, std::string* result)
+{
+    const std::string token = std::string("\"") + key + "\":\"";
+    const size_t begin = json.find(token);
+    if (begin == std::string::npos)
+        return false;
+    size_t cursor = begin + token.size();
+    std::string value;
+    while (cursor < json.size())
+    {
+        const char c = json[cursor++];
+        if (c == '"')
+        {
+            *result = value;
+            return true;
+        }
+        if (c == '\\' && cursor < json.size())
+        {
+            const char escaped = json[cursor++];
+            if (escaped == '/' || escaped == '\\' || escaped == '"') value += escaped;
+            else if (escaped == 'n') value += '\n';
+            else if (escaped == 'r') value += '\r';
+            else if (escaped == 't') value += '\t';
+            else return false;
+        }
+        else value += c;
+    }
+    return false;
+}
