+static int vitaFindRoot(std::vector<int>& parent, int value)
+{
+    int root = value;
+    // A root stores its negative component size. Non-roots store an index.
+    while (parent[root] >= 0)
+        root = parent[root];
+
+    while (parent[value] >= 0)
+    {
+        int next = parent[value];
+        parent[value] = root;
+        value = next;
+    }
+
+    return root;
+}
+
+static void vitaUnionRoots(std::vector<int>& parent, int a, int b)
+{
+    a = vitaFindRoot(parent, a);
+    b = vitaFindRoot(parent, b);
+    if (a != b)
+    {
+        // Attach the smaller island to the larger. Adversarial connector order
+        // cannot create a linear parent chain before the next compression pass.
+        // Sizes fit in the existing parent buffer, with no extra scratch array.
+        if (parent[a] > parent[b]) std::swap(a, b);
+        parent[a] += parent[b];
+        parent[b] = a;
+    }
+}
