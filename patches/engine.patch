+}
+
+static bool vitaLegacyThumbnailRequest(const std::string& rawUrl, std::string& assetId, std::string& size)
+{
+    std::string lower = rawUrl;
+    std::transform(lower.begin(), lower.end(), lower.begin(), ::tolower);
+
+    const char* prefixes[] = {
+        "http://www.roblox.com/thumbs/asset.ashx",
+        "https://www.roblox.com/thumbs/asset.ashx",
+        "http://roblox.com/thumbs/asset.ashx",
+        "https://roblox.com/thumbs/asset.ashx"
+    };
+    bool supported = false;
+    for (const char* prefix : prefixes)
+    {
+        const std::string candidate(prefix);
+        if (lower.compare(0, candidate.size(), candidate) == 0)
+        {
+            supported = true;
+            break;
+        }
+    }
+    if (!supported)
+        return false;
+
+    unsigned width = 0;
+    unsigned height = 0;
+    const size_t query = lower.find('?');
+    if (query == std::string::npos)
+        return false;
+
+    size_t cursor = query + 1;
+    while (cursor < lower.size())
+    {
+        const size_t next = lower.find('&', cursor);
+        const size_t end = next == std::string::npos ? lower.size() : next;
+        const size_t equals = lower.find('=', cursor);
+        if (equals != std::string::npos && equals < end)
+        {
+            const std::string key = lower.substr(cursor, equals - cursor);
+            const std::string value = lower.substr(equals + 1, end - equals - 1);
+            if (!value.empty() && value.find_first_not_of("0123456789") == std::string::npos)
+            {
+                if (key == "assetid")
+                    assetId = value;
+                else if (key == "width")
+                    width = static_cast<unsigned>(std::strtoul(value.c_str(), NULL, 10));
+                else if (key == "height")
+                    height = static_cast<unsigned>(std::strtoul(value.c_str(), NULL, 10));
+            }
+        }
+        if (next == std::string::npos)
+            break;
+        cursor = next + 1;
+    }
+
+    if (assetId.empty())
+        return false;
+
+    // Roblox's retired endpoint accepted arbitrary dimensions. The current
+    // thumbnail API accepts a fixed set; use a compact supported shape nearest
+    // the caller's intent instead of upscaling every request to a large image.
+    size = width && height && width >= (height * 3) / 2 ? "384x216" : "420x420";
+    return true;
+}
+
+static std::string vitaLegacyThumbnailCachePath(const std::string& assetId, const std::string& size)
+{
+    return "ux0:/data/RBXV00001/system/thumbnails/asset-" + assetId + "-" + size + ".png";
+}
+
+static bool vitaReadLegacyThumbnailCache(const std::string& assetId, const std::string& size, std::string& response)
+{
+    const std::string path = vitaLegacyThumbnailCachePath(assetId, size);
+    const auto gate = vitaAssetFileLocks.get(path);
+    boost::mutex::scoped_lock lock(*gate);
+    FILE* file = std::fopen(path.c_str(), "rb");
+    if (!file)
+        return false;
+
+    std::fseek(file, 0, SEEK_END);
+    const long length = std::ftell(file);
+    std::fseek(file, 0, SEEK_SET);
+    if (length <= 0 || length > 4 * 1024 * 1024)
+    {
+        std::fclose(file);
+        sceIoRemove(path.c_str());
+        return false;
+    }
+
+    std::string cached(static_cast<size_t>(length), '\0');
+    const size_t read = std::fread(&cached[0], 1, cached.size(), file);
+    std::fclose(file);
+    if (read != cached.size() || !vitaIsPng(cached))
+    {
+        sceIoRemove(path.c_str());
+        return false;
+    }
+
+    response.swap(cached);
+    return true;
+}
+
+static void vitaPersistLegacyThumbnail(const std::string& assetId, const std::string& size, const std::string& data)
+{
+    if (!vitaIsPng(data))
+        return;
+
+    const auto gate = vitaAssetFileLocks.get(vitaLegacyThumbnailCachePath(assetId, size));
+    boost::mutex::scoped_lock lock(*gate);
+    sceIoMkdir("ux0:/data/RBXV00001", 0777);
+    sceIoMkdir("ux0:/data/RBXV00001/system/thumbnails", 0777);
+    const std::string finalPath = vitaLegacyThumbnailCachePath(assetId, size);
+    const std::string tempPath = finalPath + ".download";
+
+    FILE* file = std::fopen(tempPath.c_str(), "wb");
+    if (!file)
+        return;
+    const size_t written = std::fwrite(data.data(), 1, data.size(), file);
+    std::fclose(file);
+    if (written != data.size())
+    {
+        sceIoRemove(tempPath.c_str());
+        return;
+    }
+
+    sceIoRemove(finalPath.c_str());
+    if (sceIoRename(tempPath.c_str(), finalPath.c_str()) < 0)
+        sceIoRemove(tempPath.c_str());
+}
+
+static bool vitaFetchPublicThumbnail(const std::string& assetId, const std::string& size,
+    const std::string& endpoint, std::string& response)
+{
+    if (vitaReadLegacyThumbnailCache(assetId, size, response))
+        return true;
+
+    try
+    {
+        std::string metadata;
+        Http metadataRequest(endpoint);
+        metadataRequest.shouldRetry = false;
+        metadataRequest.setConnectionTimeout(5000);
+        metadataRequest.setResponseTimeout(15000);
+        metadataRequest.get(metadata, true);
+
+        shared_ptr<const RBX::Reflection::ValueTable> table;
+        if (!RBX::WebParser::parseJSONTable(metadata, table) || !table)
+            return false;
+        RBX::Reflection::ValueTable::const_iterator dataIt = table->find("data");
+        if (dataIt == table->end() ||
+            !dataIt->second.isType<shared_ptr<const Reflection::ValueArray> >())
+            return false;
+
+        shared_ptr<const Reflection::ValueArray> entries =
+            dataIt->second.cast<shared_ptr<const Reflection::ValueArray> >();
+        if (entries->empty() || !(*entries)[0].isType<shared_ptr<const Reflection::ValueTable> >())
+            return false;
+        shared_ptr<const Reflection::ValueTable> entry =
+            (*entries)[0].cast<shared_ptr<const Reflection::ValueTable> >();
+
+        Reflection::ValueTable::const_iterator state = entry->find("state");
+        Reflection::ValueTable::const_iterator image = entry->find("imageUrl");
+        if (state == entry->end() || !state->second.isString() ||
+            state->second.get<std::string>() != "Completed" ||
+            image == entry->end() || !image->second.isString())
+            return false;
+
+        const std::string publicLocation = image->second.get<std::string>();
+        if (!vitaTrustedPublicAssetLocation(publicLocation))
+            return false;
+
+        Http payloadRequest(publicLocation);
+        payloadRequest.shouldRetry = false;
+        payloadRequest.setConnectionTimeout(5000);
+        payloadRequest.setResponseTimeout(15000);
+        std::string payload;
+        payloadRequest.get(payload, true);
+        if (payload.empty() || payload.size() > 4 * 1024 * 1024 || !vitaIsPng(payload))
+            return false;
+
+        vitaPersistLegacyThumbnail(assetId, size, payload);
+        response.swap(payload);
+        return true;
+    }
+    catch (const std::exception&)
+    {
+        return false;
+    }
+}
