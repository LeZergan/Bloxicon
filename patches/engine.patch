+bool PartOperation::useVitaSolidSlabFallback() const
+{
+#ifdef RBX_PLATFORM_PSVITA
+	// Modern saves can carry only a private external CSG asset ID. With no
+	// local render payload the original engine makes the union invisible.
+	// Some places retain only a CSGK collision dictionary reference, which is
+	// not an embedded mesh and must not disqualify the visible slab fallback.
+	// Restore only broad horizontal structural slabs;
+	// approximating arbitrary unions would fill door and window cutouts.
+	const std::string& collision = physicsData.value();
+	if (!dynamic_cast<const UnionOperation*>(this) || !hasAssetId ||
+		!meshData.value().empty() ||
+		(!collision.empty() && collision.compare(0, 4, "CSGK") != 0) ||
+		!getAnchored() || !getCanCollide())
+		return false;
+	const Vector3 size = getPartSizeXml();
+	return size.x >= 4.0f && size.z >= 4.0f && size.y > 0.0f && size.y <= 1.5f;
+#else
+	return false;
+#endif
+}
