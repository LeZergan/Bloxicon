@@ -8,0 +11,18 @@ namespace RBX
+// MeshId/BaseTextureId/OverlayTextureId remain the original integer properties.
+// Offline avatar delivery can additionally bind each integer to its verified
+// content hash using ordinary replicated values. Never apply an old binding
+// after a game changes the integer, and keep normal place meshes unchanged.
+static std::string verifiedBodyAsset(const CharacterMesh* mesh,const char* field,int assetId)
+{
+    if(assetId<=0)return {};
+    const StringValue* value=NULL;
+    if(const auto& children=mesh->getChildren())for(const auto& child:*children)
+        if(child->getName()==field){value=Instance::fastDynamicCast<StringValue>(child.get());break;}
+    if(!value)return {};
+    const std::string prefix=std::to_string(assetId)+":";
+    const auto& binding=value->getValue();
+    if(binding.compare(0,prefix.size(),prefix))return {};
+    const std::string hash=binding.substr(prefix.size());
+    return OfflineAvatarCache::validHash(hash)?"rbxasset://avatar-network/"+hash:std::string();
+}
+
@@ -58,0 +79,17 @@ void CharacterMesh::onPropertyChanged(const Reflection::PropertyDescriptor& desc
+static bool isVerifiedBodyBinding(Instance* child)
+{
+    return Instance::fastDynamicCast<StringValue>(child) &&
+        (child->getName()=="_RBXVMeshId" || child->getName()=="_RBXVBaseTextureId" || child->getName()=="_RBXVOverlayTextureId");
+}
+void CharacterMesh::onChildAdded(Instance* child)
+{
+    // Replication fills immutable binding values before assigning their parent.
+    // A renderer may already have cached the integer resource from the mesh's
+    // own creation packet, so it must rebuild when the binding arrives later.
+    if(isVerifiedBodyBinding(child))CharacterAppearance::apply();
+}
+void CharacterMesh::onChildRemoved(Instance* child)
+{
+    if(isVerifiedBodyBinding(child))CharacterAppearance::apply();
+}
+
