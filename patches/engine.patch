+static ThreadPool& vitaPhysicsPool(int worker)
+{
+    // Reuse the original queues. The optional helper claims ordinary shared
+    // work; it never owns an irreplaceable fixed island partition on CPU3.
+    static ThreadPool pool0(1, BaseThreadPool::WaitForRunningTasks);
+    static ThreadPool pool1(1, BaseThreadPool::WaitForRunningTasks);
+    if (worker == 2)
+    {
+        static ThreadPool extraPool(1, BaseThreadPool::WaitForRunningTasks);
+        return extraPool;
+    }
+    return worker == 0 ? pool0 : pool1;
+}
+
+static void solveVitaPhysicsBatch(VitaPhysicsBatch& batch)
+{
+    for (int i = 0; i < Constants::kernelStepsPerWorldStep(); ++i)
+    {
+        for (size_t j = 0; j < batch.connectors.size(); ++j)
+            batch.connectors[j]->computeForce(false);
+
+        // BodyGyro reads accumulated contact torque: preserve the original
+        // contact -> second-pass -> integration order in every substep.
+        for (size_t j = 0; j < batch.secondPass.size(); ++j)
+            batch.secondPass[j]->computeForce(false);
+
+        for (size_t j = 0; j < batch.bodies.size(); ++j)
+            batch.bodies[j]->step();
+
+        for (size_t j = 0; j < batch.leaves.size(); ++j)
+            batch.leaves[j]->getPvUnsafe();
+    }
+}
+
+static void claimVitaPhysicsBatches(VitaPhysicsWait& work, unsigned worker)
+{
+    const double begin = work.profile ? Time::nowFastSec() : 0.0;
+    try
+    {
+        for (;;)
+        {
+            // Data was published by the start mutex. The atomic is only an
+            // exactly-once index; no spinning or per-constraint barrier.
+            const unsigned index = work.nextBatch.fetch_add(1, std::memory_order_relaxed);
+            if (index >= work.batchCount)
+                break;
+            if (work.batches[index].connectors.empty() && work.batches[index].bodies.empty())
+                continue;
+            solveVitaPhysicsBatch(work.batches[index]);
+            ++work.claimed[worker];
+        }
+    }
+    catch (...)
+    {
+        boost::unique_lock<boost::mutex> lock(work.mutex);
+        if (!work.failure)
+            work.failure = std::current_exception();
+    }
+    if (work.profile)
+        work.workMs[worker] += (Time::nowFastSec() - begin) * 1000.0;
+}
+
+static void runVitaPhysicsClaims(boost::shared_ptr<VitaPhysicsWait> work,
+    unsigned worker, boost::shared_ptr<rbx::spin_mutex>)
+{
+    {
+        boost::unique_lock<boost::mutex> lock(work->mutex);
+        while (!work->start)
+            work->condition.wait(lock, VitaPhysicsSignal::Published);
+    }
+    unsigned expected = VitaPhysicsWait::Queued;
+    if (!work->workerState[worker].compare_exchange_strong(expected,
+        VitaPhysicsWait::Running, std::memory_order_acq_rel))
+    {
+        // A late invocation owns only this per-step tombstone, never a reused
+        // batch/world pointer. The caller already finished its unclaimed work.
+        vitaPhysicsWorkerPending[worker].store(false, std::memory_order_release);
+        return;
+    }
+    if (worker == 2)
+    {
+        // Unlike the rejected fixed CPU3 pin, this helper can migrate to a user
+        // core if the system core is occupied. Probe its own actual affinity.
+        static int configuredMask = -1;
+        static int lastRequestedMask = -1; // Only the single extraPool thread.
+        const int desired = vitaCpu3PhysicsWorkerEnabled.load(std::memory_order_acquire)
+            ? SCE_KERNEL_CPU_MASK_USER_ALL | SCE_KERNEL_CPU_MASK_SYSTEM
+            : SCE_KERNEL_CPU_MASK_USER_ALL;
+        if (lastRequestedMask != desired)
+        {
+            const SceUID self = sceKernelGetThreadId();
+            const int result = sceKernelChangeThreadCpuAffinityMask(self, desired);
+            const int observed = result >= 0 ? sceKernelGetThreadCpuAffinityMask(self) : result;
+            if (observed >= 0 && (observed & desired) == desired)
+                configuredMask = observed;
+            else
+            {
+                const int fallback = sceKernelChangeThreadCpuAffinityMask(self, SCE_KERNEL_CPU_MASK_USER_ALL);
+                configuredMask = fallback >= 0 ? sceKernelGetThreadCpuAffinityMask(self) : fallback;
+                vitaCpu3PhysicsWorkerEnabled.store(false, std::memory_order_release);
+            }
+            lastRequestedMask = desired;
+        }
+        work->extraAffinity = configuredMask;
+    }
+    // A failed CPU3 probe must not quietly add a third competing user-core
+    // helper. The existing helpers/caller retain all unclaimed work.
+    if (worker != 2 || (work->extraAffinity >= 0 &&
+        (work->extraAffinity & SCE_KERNEL_CPU_MASK_SYSTEM) != 0))
+        claimVitaPhysicsBatches(*work, worker);
+    vitaPhysicsWorkerPending[worker].store(false, std::memory_order_release);
+    boost::unique_lock<boost::mutex> lock(work->mutex);
+    work->workerState[worker].store(VitaPhysicsWait::Finished, std::memory_order_release);
+    if (--work->remaining == 0)
+        work->condition.notify(VitaPhysicsSignal::Completed);
+}
+
+static void finishVitaPhysicsClaims(VitaPhysicsWait& work)
+{
+    // Help only with this step's proven-independent contact islands. Never run
+    // unrelated scheduler work while holding the DataModel/physics lock.
+    claimVitaPhysicsBatches(work, 3);
+    boost::unique_lock<boost::mutex> lock(work.mutex);
+    for (unsigned worker = 0; worker < 3; ++worker)
+    {
+        unsigned expected = VitaPhysicsWait::Queued;
+        if (work.workerState[worker].compare_exchange_strong(expected,
+            VitaPhysicsWait::Cancelled, std::memory_order_acq_rel))
+            --work.remaining;
+    }
+    while (work.remaining > 0)
+        work.condition.wait(lock, VitaPhysicsSignal::Completed);
+    if (work.failure)
+        std::rethrow_exception(work.failure);
+}
+
+struct VitaPhysicsCompletion
+{
+    boost::shared_ptr<VitaPhysicsWait> work;
+    bool finished;
+    VitaPhysicsCompletion() : finished(false) {}
+    void finish()
+    {
+        if (!finished && work)
+        {
+            finished = true;
+            finishVitaPhysicsClaims(*work);
+        }
+    }
+    ~VitaPhysicsCompletion()
+    {
+        // A serial solver exception must not leave helpers accessing the world
+        // after its lock is released. Preserve the original unwinding error.
+        try { finish(); } catch (...) {}
+    }
+};
+
+static unsigned dispatchVitaPhysicsClaims(boost::shared_ptr<VitaPhysicsWait> work,
+    unsigned helpers)
+{
+    unsigned scheduled = 0;
+    for (unsigned worker = 0; worker < helpers; ++worker)
+    {
+        // At most one queued invocation per original helper. A suspended core
+        // cannot accumulate one cancelled allocation/job per physics step.
+        if (vitaPhysicsWorkerPending[worker].exchange(true, std::memory_order_acq_rel))
+            continue;
+        work->workerState[worker].store(VitaPhysicsWait::Queued, std::memory_order_relaxed);
+        bool accepted = false;
+        try
+        {
+            accepted = vitaPhysicsPool(worker).schedule(boost::bind(
+                &runVitaPhysicsClaims, work, worker, _1));
+        }
+        catch (...)
+        {
+            // Helpers are optional. The caller claims every unstarted batch,
+            // including after partial queue/allocation failure.
+        }
+        if (accepted)
+            ++scheduled;
+        else
+        {
+            work->workerState[worker].store(VitaPhysicsWait::Dormant, std::memory_order_relaxed);
+            vitaPhysicsWorkerPending[worker].store(false, std::memory_order_release);
+        }
+    }
+    {
+        boost::unique_lock<boost::mutex> lock(work->mutex);
+        work->remaining = scheduled;
+        work->start = true;
+        work->condition.notify(VitaPhysicsSignal::Published);
+    }
+    return scheduled;
+}
