+void LightGrid::lightingUploadPending()
+{
+    if (!texture || texture->getType() != Texture::Type_2D || uploadAtlasScratch.empty() || uploadTextures.size() < 2)
+        return;
+
+    const int textureWidth = texture->getWidth();
+    const int textureHeight = texture->getHeight();
+    const int atlasPitch = textureWidth * 4;
+    const size_t targetIndex = (uploadTextureIndex + 1) % uploadTextures.size();
+    ++uploadFrame;
+    // vitaGL retains sampled textures for FRAME_PURGE_FREQ (four frames).
+    // Reusing one earlier causes glTexSubImage2D to allocate/copy the entire
+    // atlas. The resulting allocation churn crashed large places. Wait for
+    // retirement before touching an inactive buffer, without stalling the GPU.
+    if (uploadFrame < uploadTextureSafeFrame[targetIndex]) return;
+    std::vector<unsigned char>& targetDirtyRows = uploadTextureDirtyRows[targetIndex];
+
+    // Freeze a generation before draining it. Live lights can dirty the first
+    // band every frame; scanning live dirty rows from zero starves all later
+    // bands forever. Relocations must also keep their own coordinate origin.
+    if (uploadSnapshotRows.empty())
+    {
+        if (std::find(targetDirtyRows.begin(), targetDirtyRows.end(), 1) == targetDirtyRows.end())
+            return;
+        // Freeze without a multi-megabyte copy on this gameplay frame. The
+        // spare atlas was allocated during bulk loading; lazily seed its bands
+        // from this immutable snapshot before edits and before the next swap.
+        RBXASSERT(uploadSnapshot.size() == uploadAtlasScratch.size());
+        uploadSnapshot.swap(uploadAtlasScratch);
+        uploadSnapshotRows = targetDirtyRows;
+        std::fill(targetDirtyRows.begin(), targetDirtyRows.end(), 0);
+        uploadSnapshotCorner = cornerChunkIndex;
+        uploadSnapshotRow = 0;
+        uploadSnapshotBandOffset = 0;
+        uploadAtlasCopiedRows.assign(uploadSnapshotRows.size(), 0);
+        uploadAtlasCopyRow = 0;
+    }
+
+    // Bound baseline cloning to 512 KiB per frame. Edits can seed their own
+    // bands sooner; those newer bytes must never be overwritten here.
+    unsigned copied = 0;
+    while (uploadAtlasCopyRow < uploadAtlasCopiedRows.size() && copied < 4)
+    {
+        if (!uploadAtlasCopiedRows[uploadAtlasCopyRow])
+        {
+            lightingSeedAtlasBand(uploadAtlasCopyRow);
+            ++copied;
+        }
+        ++uploadAtlasCopyRow;
+    }
+
+	// Keep each interactive GL transfer to 64 KiB. Initial/bulk loading still
+	// uses lightingUploadAll;
+	// gameplay keeps the same immutable snapshot and atomic texture swap, so the
+	// final lighting data is unchanged while the work is frame-paced.
+	while (uploadSnapshotRow < uploadSnapshotRows.size() && !uploadSnapshotRows[uploadSnapshotRow])
+		++uploadSnapshotRow;
+
+	if (uploadSnapshotRow < uploadSnapshotRows.size())
+	{
+		const size_t firstRow = uploadSnapshotRow;
+		const int top = static_cast<int>(firstRow) * kLightGridChunkSizeXZ + uploadSnapshotBandOffset;
+		const int height = std::min(16, std::min(kLightGridChunkSizeXZ - int(uploadSnapshotBandOffset),
+			textureHeight - top));
+		uploadTextures[targetIndex]->upload(0, 0, TextureRegion(0, top, textureWidth, height),
+			&uploadSnapshot[top * atlasPitch], static_cast<size_t>(atlasPitch) * height);
+		uploadSnapshotBandOffset += height;
+		if (uploadSnapshotBandOffset == size_t(kLightGridChunkSizeXZ))
+		{
+			++uploadSnapshotRow;
+			uploadSnapshotBandOffset = 0;
+		}
+
+		// Skip clean rows without spending another GL submission this frame. If
+		// there is another dirty band, resume from it next frame; otherwise the
+		// complete coherent snapshot can be published immediately below.
+		while (uploadSnapshotRow < uploadSnapshotRows.size() && !uploadSnapshotRows[uploadSnapshotRow])
+			++uploadSnapshotRow;
+		if (uploadSnapshotRow < uploadSnapshotRows.size())
+			return;
+	}
+
+    if (uploadAtlasCopyRow < uploadAtlasCopiedRows.size()) return;
+
+    // The complete atlas and the shader coordinate origin move together.
+    // The texture that was sampled by the previous frame is never modified.
+    uploadTextureSafeFrame[uploadTextureIndex] = uploadFrame + 5;
+    uploadTextureIndex = targetIndex;
+    texture = uploadTextures[uploadTextureIndex];
+    textureRef.updateAllRefs(texture);
+    renderCornerChunkIndex = uploadSnapshotCorner;
+    uploadSnapshotRows.clear();
+}
