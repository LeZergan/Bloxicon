+static void updateVitaContentWorkerAffinity()
+{
+	// findLocalFile is called by ContentProvider's request pool, before its
+	// file/network work. Allow these independent workers to use CPU3 without
+	// moving the render, script or physics scheduler there.
+	static std::atomic<bool> cpu3Rejected(false);
+	static std::atomic<bool> reported(false);
+	const bool enabled = RBX::vitaCpu3ContentWorkerEnabled.load(std::memory_order_acquire) &&
+		!cpu3Rejected.load(std::memory_order_relaxed);
+	const int desired = enabled
+		? SCE_KERNEL_CPU_MASK_USER_ALL | SCE_KERNEL_CPU_MASK_SYSTEM
+		: SCE_KERNEL_CPU_MASK_USER_ALL;
+	static thread_local int lastRequestedMask = -1;
+	if (lastRequestedMask == desired) return;
+	const SceUID thread = sceKernelGetThreadId();
+	int active = sceKernelGetThreadCpuAffinityMask(thread);
+	if (active != desired)
+	{
+		const int result = sceKernelChangeThreadCpuAffinityMask(thread, desired);
+		active = result >= 0 ? sceKernelGetThreadCpuAffinityMask(thread) : result;
+	}
+	if (enabled && (active < 0 || (active & desired) != desired))
+	{
+		cpu3Rejected.store(true, std::memory_order_relaxed);
+		const int fallback = sceKernelChangeThreadCpuAffinityMask(thread, SCE_KERNEL_CPU_MASK_USER_ALL);
+		lastRequestedMask = fallback >= 0 &&
+			sceKernelGetThreadCpuAffinityMask(thread) == SCE_KERNEL_CPU_MASK_USER_ALL
+			? SCE_KERNEL_CPU_MASK_USER_ALL : -1;
+		if (!reported.exchange(true))
+			std::fprintf(stderr, "Vita content worker CPU3 unavailable; using user cores\n");
+	}
+	else
+	{
+		lastRequestedMask = active == desired ? desired : -1;
+		if (enabled && !reported.exchange(true))
+			std::fprintf(stderr, "Vita content workers eligible for CPU3\n");
+	}
+}
