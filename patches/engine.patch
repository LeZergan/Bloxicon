+static std::atomic<bool> vitaCpu3PhysicsWorkerEnabled(false);
+static std::atomic<bool> vitaPhysicsWorkerPending[3] = {false, false, false};
+
+void setVitaCpu3PhysicsWorkerEnabled(bool enabled)
+{
+    vitaCpu3PhysicsWorkerEnabled.store(enabled, std::memory_order_release);
+}
