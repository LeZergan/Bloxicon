+static int vitaJointBodyIndex(Body* body)
+{
+    if (!body)
+        return -1;
+
+    SimBody* simBody = body->getRootSimBody();
+    return simBody && simBody->isJointBody() ? simBody->getJointBodyIndex() : -1;
+}
