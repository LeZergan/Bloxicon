+
+static double taskTimeout(lua_State* thread, int index)
+{
+	double timeout = luaL_optnumber(thread, index, 0);
+	if (Math::isNanInf(timeout))
+		throw RBX::runtime_error("task duration must be finite");
+	return std::max(0.0, timeout);
+}
+
+int ScriptContext::taskSpawn(lua_State* thread)
+{
+	return scheduleTask(thread, 1, 0, true);
+}
+
+int ScriptContext::taskDefer(lua_State* thread)
+{
+	return scheduleTask(thread, 1, 0, false);
+}
+
+int ScriptContext::taskDelay(lua_State* thread)
+{
+	return scheduleTask(thread, 2, taskTimeout(thread, 1), false);
+}
+
+int ScriptContext::taskWait(lua_State* thread)
+{
+	const double timeout = taskTimeout(thread, 1);
+	if (Lua::YieldingThreads* event = getContext(thread).yieldEvent.get())
+		event->queueTask(thread, timeout, -2);
+	return lua_yield(thread, 0);
+}
