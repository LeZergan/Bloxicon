+static SimBody* createBodySimulation(Body* owner)
+{
+#ifdef RBX_PLATFORM_PSVITA
+    // Most parts briefly become roots during insertion, then join an anchored
+    // or welded assembly. The singleton pool retained that transient high-water
+    // mark for the rest of the session. Keep the exact SimBody, but return its
+    // storage to the ordinary heap as soon as the assembly no longer needs it.
+    void* storage = ::operator new(sizeof(SimBody));
+    try { return ::new (storage) SimBody(owner); }
+    catch (...) { ::operator delete(storage); throw; }
+#else
+    return new SimBody(owner);
+#endif
+}
+
+static void destroyBodySimulation(SimBody* simulation)
+{
+#ifdef RBX_PLATFORM_PSVITA
+    if (simulation)
+    {
+        simulation->~SimBody();
+        ::operator delete(simulation);
+    }
+#else
+    delete simulation;
+#endif
+}
