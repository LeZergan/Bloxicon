+static bool vitaFetchPublicAssetThumbnail(const std::string& assetId, const std::string& size, std::string& response)
+{
+    return vitaFetchPublicThumbnail(assetId, size, "https://thumbnails.roblox.com/v1/assets?assetIds=" + assetId +
+        "&returnPolicy=PlaceHolder&size=" + size + "&format=Png&isCircular=false", response);
+}
