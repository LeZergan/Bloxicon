+bool TextureManager::rebalanceVitaTextures(unsigned int requiredBytes, unsigned int budget)
+{
+    while (size_t(liveSize) + orphanedSize + requiredBytes > budget)
+    {
+        TextureData* largest = NULL;
+        unsigned int largestSize = 0;
+        for (Textures::iterator it = textures.begin(); it != textures.end(); ++it)
+        {
+            TextureData& data = it->second;
+            if (data.orphaned || data.object.getStatus() != TextureRef::Status_Loaded || !data.pressureMips ||
+                data.pressureNextMip >= data.pressureMips->getMipLevels()) continue;
+            const unsigned int oldSize = getTextureSize(data.object.getTexture());
+            const unsigned int newSize = getImageTextureSize(*data.pressureMips,
+                data.pressureMips->getMipLevels() - data.pressureNextMip, data.pressureNextMip);
+            if (newSize < oldSize && oldSize > largestSize)
+            {
+                largest = &data;
+                largestSize = oldSize;
+            }
+        }
+        if (!largest) return false;
+        try
+        {
+            const unsigned int first = largest->pressureNextMip;
+            shared_ptr<Texture> replacement = createTextureMipRange(*largest->pressureMips, first,
+                largest->pressureMips->getMipLevels() - first);
+            replacement->setDebugName(largest->id.toString());
+            const ImageInfo info = largest->object.getInfo();
+            largest->updateAllRefsToWaiting();
+            largest->updateAllRefsToLoaded(replacement, info);
+            liveSize = liveSize - largestSize + getTextureSize(replacement);
+            ++largest->pressureNextMip;
+            if (DFFlag::VitaPerformanceLogging)
