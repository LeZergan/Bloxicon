@@ -104,0 +105,7 @@ struct InstructionP
+#if defined(RBX_PLATFORM_PSVITA) || defined(RBX_HEADLESS_SERVER)
+// Register operands and Proto::maxstacksize are eight bits. The compiler
+// rejects newstack >= MAXSTACK, so 256 permits at most 255 slots (indices
+// 0..254), leaving register 255 as NO_REG. This fits 200 generic-for results
+// plus the constructor's 50-value flush window inside a function call.
+#define MAXSTACK 256
+#else
@@ -105,0 +113 @@ struct InstructionP
+#endif
