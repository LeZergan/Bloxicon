+template<class Bodies, class Connectors, class SecondPass, class Leaves, class Points, class Kind>
+static bool sameVitaPhysicsTopology(VitaPhysicsTopology& topology,
+    const Bodies& bodies, const Connectors& connectors, const SecondPass& secondPass,
+    const Leaves& leaves, const Points& points, Kind kind)
+{
+    topology.begin();
+    topology.add(bodies.size());topology.add(connectors.size());
+    topology.add(secondPass.size());
+    topology.add(leaves.size());topology.add(points.size());
+    for (int i = 0; i < bodies.size(); ++i)
+    {
+        SimBody* body = bodies[i];topology.pointer(body);
+        topology.add(body->getHumanoidConnectorCount());
+        topology.add(body->getSecondPassConnectorCount());
+        topology.add(body->getRealTimeConnectorCount());
+    }
+    auto endpoint = [&](Body* body) {
+        SimBody* sim = body ? body->getRootSimBody() : NULL;
+        topology.pointer(body);topology.pointer(sim);
+        topology.add(sim && sim->isJointBody());
+        topology.add(sim && sim->isJointBody() ? sim->getJointBodyIndex() : -1);
+        topology.add(sim && sim->isInKernel());
+    };
+    for (int i = 0; i < connectors.size(); ++i)
+    {
+        Connector* connector = connectors[i];topology.pointer(connector);
+        topology.add(kind(connector));
+        endpoint(connector->getBody(Connector::body0));
+        endpoint(connector->getBody(Connector::body1));
+    }
+    for (int i = 0; i < leaves.size(); ++i) endpoint(leaves[i]);
+    for (int i = 0; i < secondPass.size(); ++i)
+    {
+        Connector* connector = secondPass[i];topology.pointer(connector);
+        topology.add(vitaLocalSecondPassKind(connector));
+        endpoint(connector->getBody(Connector::body0));
+        endpoint(connector->getBody(Connector::body1));
+    }
+    for (int i = 0; i < points.size(); ++i)
+    {
+        topology.pointer(points[i]);endpoint(points[i]->getBody());
+    }
+    return topology.end();
+}
