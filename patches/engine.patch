+// This fence is private to the Vita solver. Boost's interruptible condition
+// wait reached EPERM/EINVAL on hardware after sustained island dispatch.
+// Persistent native bits avoid that PTE condition path and lost notifications.
+// A record is cleared only after all references (including late queues) retire.
+struct VitaPhysicsSignal
+{
+    enum { Published = 1, Completed = 2 };
+    SceUID event;
+    VitaPhysicsSignal()
+        : event(sceKernelCreateEventFlag("rbx_physics", SCE_EVENT_WAITMULTIPLE, 0, NULL)) {}
+    ~VitaPhysicsSignal() { if (event >= 0) sceKernelDeleteEventFlag(event); }
+    void reset() { if (event >= 0) sceKernelClearEventFlag(event, 0); }
+    void notify(unsigned bits) { if (event >= 0) sceKernelSetEventFlag(event, bits); }
+    void wait(boost::unique_lock<boost::mutex>& lock, unsigned bits)
+    {
+        lock.unlock();
+        unsigned observed = 0;
+        // A bounded wait also permits predicate rechecking after native resource
+        // failure. Never release the world fence while a helper is still running.
+        unsigned timeout = 1000;
+        if (event < 0 || sceKernelWaitEventFlag(event, bits, SCE_EVENT_WAITAND,
+            &observed, &timeout) < 0)
+            sceKernelDelayThread(50);
+        lock.lock();
+    }
+private:
+    VitaPhysicsSignal(const VitaPhysicsSignal&);
+    VitaPhysicsSignal& operator=(const VitaPhysicsSignal&);
+};
+
+// Audited legacy controllers access only their owning root and immutable goal
+// properties. Exact dynamic types deliberately exclude future subclasses and
+// Rocket's hidden target dependency. PGS never enters this solver path.
+static unsigned vitaLocalSecondPassKind(Connector* connector)
+{
+    if (typeid(*connector) == typeid(BodyPosition)) return 1;
+    if (typeid(*connector) == typeid(BodyGyro)) return 2;
+    if (typeid(*connector) == typeid(BodyVelocity)) return 3;
+    if (typeid(*connector) == typeid(BodyAngularVelocity)) return 4;
+    if (typeid(*connector) == typeid(BodyForce)) return 5;
+    if (typeid(*connector) == typeid(BodyThrust)) return 6;
+    return 0;
+}
+
+struct VitaPhysicsWait
+{
+    // Immutable after publication until every helper invocation has retired.
+    static const unsigned maxBatches = 8;
+    VitaPhysicsBatch* batches;
+    std::atomic<unsigned> nextBatch;
+    unsigned batchCount;
+    boost::mutex mutex;
+    VitaPhysicsSignal condition;
+    int remaining;
+    bool start;
+    bool profile;
+    std::exception_ptr failure;
+    unsigned claimed[4];
+    double workMs[4];
+    int extraAffinity;
+    enum WorkerState { Dormant, Queued, Running, Finished, Cancelled };
+    std::atomic<unsigned> workerState[3];
+
+    VitaPhysicsWait(VitaPhysicsBatch* storage, unsigned count, bool measure)
+        : batches(storage)
+        , nextBatch(0)
+        , batchCount(count)
+        , remaining(0)
+        , start(false)
+        , profile(measure)
+        , extraAffinity(0)
+    {
+        reset(storage, count, measure);
+    }
+
+    // The caller may reuse this storage only with exclusive shared ownership.
+    // A queued/cancelled callback keeps its old record alive until it retires.
+    void reset(VitaPhysicsBatch* storage, unsigned count, bool measure)
+    {
+        RBXASSERT(count <= maxBatches);
+        batches = storage;
+        nextBatch.store(0, std::memory_order_relaxed);
+        batchCount = count;
+        remaining = 0;
+        start = false;
+        condition.reset();
+        profile = measure;
+        failure = std::exception_ptr();
+        extraAffinity = 0;
+        for (unsigned i = 0; i < 3; ++i)
+            workerState[i].store(Dormant, std::memory_order_relaxed);
+        std::fill(claimed, claimed + 4, 0);
+        std::fill(workMs, workMs + 4, 0.0);
+    }
+};
