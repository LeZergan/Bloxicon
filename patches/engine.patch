+void TextureManager::loadImageVitaThumbnail(const shared_ptr<rbx::safe_queue<LoadedImage> >& pendingImages, const ContentId& id, unsigned int maxTextureSize, unsigned int flags, const std::string& context)
+{
+    updateVitaTextureWorkerAffinity();
+    int networkState = SCE_NETCTL_STATE_DISCONNECTED;
+    if (!vitaImageAutofetchEnabled.load(std::memory_order_acquire) ||
+        sceNetCtlInetGetState(&networkState) < 0 || networkState != SCE_NETCTL_STATE_CONNECTED) {
+        loadImageError(pendingImages, id, "Wi-Fi is unavailable", context);
+        return;
+    }
+    const std::string assetId = getVitaNumericAssetId(id);
+    if (assetId.empty())
+    {
+        loadImageError(pendingImages, id, "Request failed", context);
+        return;
+    }
+
+    try
+    {
+        {
+            boost::mutex::scoped_lock lock(vitaImageAutofetchStatusMutex);
+            ++vitaImageAutofetchStarted;
+            vitaImageAutofetchStatus = "DOWNLOADING IMAGE " + assetId;
+        }
+        const std::string metadataUrl =
+            "https://thumbnails.roblox.com/v1/assets?assetIds=" + assetId +
+            "&returnPolicy=PlaceHolder&size=420x420&format=Png&isCircular=false";
+        RBX::VitaHttpRequestScope metadataLimit(64u * 1024u);
+        std::string metadata;
+        Http metadataRequest(metadataUrl);
+        metadataRequest.shouldRetry = false;
+        metadataRequest.get(metadata, true);
+
+        std::string state;
+        std::string imageUrl;
+        if (!extractVitaJsonString(metadata, "state", &state) || state != "Completed" ||
+            !extractVitaJsonString(metadata, "imageUrl", &imageUrl) || imageUrl.empty())
+        {
+            loadImageError(pendingImages, id, "Roblox thumbnail unavailable", context);
+            return;
+        }
+        if (!isTrustedVitaPublicImageUrl(imageUrl))
+        {
+            loadImageError(pendingImages, id, "Roblox thumbnail host rejected", context);
+            return;
+        }
+
+        RBX::VitaHttpRequestScope imageLimit(8u * 1024u * 1024u);
+        std::string imageBytes;
+        Http imageRequest(imageUrl);
+        imageRequest.shouldRetry = false;
+        imageRequest.get(imageBytes, true);
+        if (imageBytes.size() < 8)
+        {
+            loadImageError(pendingImages, id, "Roblox thumbnail was empty", context);
+            return;
+        }
+
+        writeVitaImageCache(assetId, imageBytes);
+        {
+            boost::mutex::scoped_lock lock(vitaImageAutofetchStatusMutex);
+            ++vitaImageAutofetchSucceeded;
+            vitaImageAutofetchStatus = "DOWNLOADED IMAGE " + assetId;
+        }
+        if (DFFlag::VitaPerformanceLogging)
+            std::fprintf(stderr, "Vita image autofetch %s (%u bytes)\n", assetId.c_str(), unsigned(imageBytes.size()));
+        loadImageHttp(pendingImages, id, shared_ptr<const std::string>(new std::string(imageBytes)), maxTextureSize, flags, context);
+    }
+    catch (const std::exception& e)
+    {
+        {
+            boost::mutex::scoped_lock lock(vitaImageAutofetchStatusMutex);
+            ++vitaImageAutofetchFailed;
+            vitaImageAutofetchStatus = "IMAGE UNAVAILABLE " + assetId;
+        }
+        if (DFFlag::VitaPerformanceLogging)
+            std::fprintf(stderr, "Vita image autofetch failed %s: %s\n", assetId.c_str(), e.what());
+        loadImageError(pendingImages, id, "Roblox thumbnail request failed", context);
+    }
+}
