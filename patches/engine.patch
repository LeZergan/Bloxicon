+static size_t vitaAssetQueryOffset(const std::string& rawUrl)
+{
+    std::string lower = rawUrl;
+    std::transform(lower.begin(),lower.end(),lower.begin(),[](unsigned char c){return char(::tolower(c));});
+    const char* prefixes[]={"http://roblox.com/asset","https://roblox.com/asset",
+        "http://www.roblox.com/asset","https://www.roblox.com/asset",
+        "http://assetgame.roblox.com/asset","https://assetgame.roblox.com/asset",
+        "http://assetdelivery.roblox.com/v1/asset","https://assetdelivery.roblox.com/v1/asset"};
+    for(const char* prefix:prefixes) {
+        const size_t n=std::strlen(prefix);
+        if(lower.compare(0,n,prefix)!=0)continue;
+        if(lower.compare(n,1,"?")==0)return n;
+        if(lower.compare(n,2,"/?")==0)return n+1;
+    }
+    return std::string::npos;
+}
+
+static std::string vitaCanonicalAssetUrl(const std::string& rawUrl)
+{
+    const size_t offset=vitaAssetQueryOffset(rawUrl);
+    if(offset==std::string::npos)return rawUrl;
+    std::string query=rawUrl.substr(offset+1);
+    query.erase(std::remove(query.begin(),query.end(),' '),query.end());
+    for(size_t cursor=0;cursor<query.size();) {
+        const size_t next=query.find('&',cursor);
+        const size_t end=next==std::string::npos?query.size():next;
+        if(end>=cursor+3 && ::tolower(static_cast<unsigned char>(query[cursor]))=='i' &&
+            ::tolower(static_cast<unsigned char>(query[cursor+1]))=='d' && query[cursor+2]=='=')
+            query.replace(cursor,2,"id");
+        if(next==std::string::npos)break;
+        cursor=next+1;
+    }
+    return "https://assetdelivery.roblox.com/v1/asset/?"+query;
+}
+
+static std::string vitaAssetIdFromUrl(const std::string& rawUrl)
+{
+    const std::string canonical=vitaCanonicalAssetUrl(rawUrl);
+    if(vitaAssetQueryOffset(canonical)==std::string::npos)return "";
+    std::string lower=canonical;
+    std::transform(lower.begin(),lower.end(),lower.begin(),[](unsigned char c){return char(::tolower(c));});
+
+    const size_t query = lower.find('?');
+    if (query == std::string::npos)
+        return "";
+
+    std::string assetId;
+    size_t cursor = query + 1;
+    while (cursor < lower.size())
+    {
+        const size_t next = lower.find('&', cursor);
+        const size_t end = next == std::string::npos ? lower.size() : next;
+        if (end >= cursor + 3 && lower.compare(cursor, 3, "id=") == 0)
+        {
+            size_t value = cursor + 3;
+            size_t digits = value;
+            while (digits < end && lower[digits] >= '0' && lower[digits] <= '9')
+                ++digits;
+            if (digits <= value || digits != end || !assetId.empty())return "";
+            assetId=lower.substr(value,digits-value);
+        }
+        if (next == std::string::npos)
+            break;
+        cursor = next + 1;
+    }
+    return assetId;
+}
