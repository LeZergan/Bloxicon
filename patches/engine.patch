+#include <map>
+#include <mutex>
+
+namespace {
+bool accountMetadataName(const RBX::Instance* value) {
+    if (!value) return false;
+    const auto& name = value->getName();
+    return name == "BloxiconRoleFlags" || name == "BloxiconRole" || name == "BloxiconIsAdmin";
+}
+bool accountMetadata(const RBX::Instance* value) {
+    for (auto* current = value; current; current = current->getParent())
+        if (accountMetadataName(current) && RBX::Instance::fastDynamicCast<RBX::Network::Player>(current->getParent())) return true;
+    return false;
+}
+template<class T, class V> void accountValue(RBX::Instance* player, const char* name, const V& value) {
+    // Remove reserved fields supplied in a client's initial Player subtree.
+    while (auto* existing = player->findFirstChildByName(name)) existing->setParent(nullptr);
+    auto field = RBX::Creatable<RBX::Instance>::create<T>();
+    field->setName(name); field->setValue(value); field->setParent(player);
+}
+void applyAccountRoles(RBX::Instance* player, unsigned flags) {
+    accountValue<RBX::IntValue>(player, "BloxiconRoleFlags", int(flags));
+    accountValue<RBX::BoolValue>(player, "BloxiconIsAdmin", bool(flags & 8));
+    const std::string role = flags & 8 ? "admin" : flags & 4 ? "moderator" : flags & 2 ? "uploader" : flags & 1 ? "tester" : "player";
+    accountValue<RBX::StringValue>(player, "BloxiconRole", role);
+}
+std::mutex presentationMutex;
+std::map<const void*,unsigned char> clientPresentations;
+void applyClientPresentation(const void* connection,RBX::Instance* player){
+    unsigned char platform=0;{std::lock_guard<std::mutex> guard(presentationMutex);auto it=clientPresentations.find(connection);if(it!=clientPresentations.end())platform=it->second;}
+    if(!platform||!player)return;
+    auto* value=RBX::Instance::fastDynamicCast<RBX::StringValue>(player->findFirstChildByName("BloxiconClientPlatform"));
+    if(!value){auto created=RBX::Creatable<RBX::Instance>::create<RBX::StringValue>();created->setName("BloxiconClientPlatform");created->setParent(player);value=created.get();}
+    value->setValue(platform==1?"PS Vita":"Windows PC");
+}
+}
